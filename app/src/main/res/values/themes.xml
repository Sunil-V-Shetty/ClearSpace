<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.ClearSpace" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/grey_1</item>
        <item name="android:navigationBarColor">@color/grey_1</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.ClearSpace.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_clearspace_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.ClearSpace</item>
    </style>
</resources>
